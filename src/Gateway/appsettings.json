{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "transfers-root": {
        "ClusterId": "transfers-cluster",
        "Order": 0,
        "Match": {
          "Path": "/transfers"
        }
      },
      "transfers-catchall": {
        "ClusterId": "transfers-cluster",
        "Order": 1,
        "Match": {
          "Path": "/transfers/{**catch-all}"
        }
      },
      "notifications-root": {
        "ClusterId": "notifications-cluster",
        "Order": 10,
        "Match": {
          "Path": "/notifications"
        }
      },
      "notifications-catchall": {
        "ClusterId": "notifications-cluster",
        "Order": 11,
        "Match": {
          "Path": "/notifications/{**catch-all}"
        }
      },
      "monolith-catchall": {
        "ClusterId": "monolith-cluster",
        "Order": 100,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "transfers-cluster": {
        "Destinations": {
          "transfers-service": {
            "Address": "http://transfers-service:8080/"
          }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "notifications-service": {
            "Address": "http://notifications-service:8080/"
          }
        }
      },
      "monolith-cluster": {
        "Destinations": {
          "monolith": {
            "Address": "http://monolith:8080/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
