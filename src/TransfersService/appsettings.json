{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=transfers_db;Username=transfers;Password=transfers-local;Search Path=transfers"
  },
  "Jwt": {
    "Secret": "replace-through-environment-with-at-least-32-characters"
  },
  "Monolith": {
    "BaseUrl": "http://localhost:8081/",
    "InternalApiKey": "replace-through-environment"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "finbank",
    "Password": "finbank-local",
    "VirtualHost": "/",
    "Exchange": "finbank.events",
    "RoutingKey": "transfers.completed.v1"
  },
  "Outbox": {
    "PollingIntervalSeconds": 2,
    "BatchSize": 20,
    "MaxAttempts": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*"
}
